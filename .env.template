# .env.template — copy to .env and fill in your values
# The .env file is gitignored and never committed.
# AWS credentials are NOT included here — they come from ~/.aws/credentials (aws configure).

# AWS IoT Core endpoint (from: aws iot describe-endpoint --endpoint-type iot:Data-ATS)
MQTT_BROKER=XXXXXXXXXXXX-ats.iot.eu-west-1.amazonaws.com
MQTT_PORT=8883

# Paths to IoT certificates (relative to repo root, or absolute)
IOT_CA_CERT=ESP32/keys/iot/AmazonRootCA1.pem
IOT_CERT=ESP32/keys/iot/device-cert.pem
IOT_KEY=ESP32/keys/iot/device-private-key.pem

# S3 bucket (override only if different from default in the script)
# S3_BUCKET=sw-embedded-iot-platform-project-firmware
# AWS_REGION=eu-west-1
