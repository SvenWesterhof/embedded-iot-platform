---
# tools/.clang-tidy — shared configuration for ESP32 and STM32 targets
# Referenced explicitly via: clang-tidy --config-file=tools/.clang-tidy
# Run via: scripts/lint.sh [esp32|stm32|common|all]

Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-diagnostic-unused-command-line-argument,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-macro-parentheses,
  cert-*,
  -cert-err10-c,
  performance-*,
  portability-*,
  readability-identifier-naming,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-identifier-length

# Only bugprone critical checks block the build; everything else is informational.
# Update WarningsAsErrors to add more checks as the codebase matures.
WarningsAsErrors: >
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-integer-division,
  bugprone-suspicious-memset-usage,
  clang-analyzer-security.insecureAPI.*

CheckOptions:
  # Enforce lower_case naming for functions and variables (project convention)
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  # Types and typedefs use lower_case with _t suffix (HAL convention)
  - key: readability-identifier-naming.TypedefCase
    value: lower_case
  # Constants and enum values use UPPER_CASE
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

# Only analyse headers inside project source directories.
# Excludes STM32 HAL, FreeRTOS, ESP-IDF internals.
HeaderFilterRegex: "(ESP32|STM32|common)/(Application|Middleware|OS|HAL|HAL_Wrapper|Drivers_BSP|common)/"

# Do not fail on system header issues
SystemHeaders: false
