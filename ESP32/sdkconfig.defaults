# ESP32 SDK Configuration Defaults

# Compiler Optimization - Use size optimization to save IRAM
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# FreeRTOS Configuration
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# IRAM Optimization - Move non-critical functions to flash
CONFIG_SPI_FLASH_ROM_IMPL=y

# Disable unnecessary IRAM placement for peripherals we don't use
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
CONFIG_MCPWM_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n

# UART can stay in flash (921600 baud doesn't need IRAM)
CONFIG_UART_ISR_IN_IRAM=n

# System Configuration
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=32
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Main task stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# HTTP Server - Enable WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y
